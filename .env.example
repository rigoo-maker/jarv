# KRYPT configuration — copy to `.env`, fill in, then `source .env` (or use a
# dotenv loader). NEVER commit your real .env (it is gitignored).

# ---- Execution venue: where live orders go ----
KRYPT_VENUE=binance         # binance | coinbase

# ---- Binance API keys (data is free/public; keys only for live Binance) ----
# Create keys at: https://www.binance.com/en/my/settings/api-management
# For first live tests use TESTNET keys from https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Coinbase Advanced Trade keys (only if KRYPT_VENUE=coinbase) ----
# Create at: https://www.coinbase.com/settings/api  (Advanced Trade / CDP key)
# NOTE: Coinbase has no fake-money testnet for this path — use KRYPT_MODE=paper
#       to simulate. Live on Coinbase = REAL money. Needs: pip install PyJWT cryptography
# NEVER paste these into chat or commit them. .env is gitignored.
COINBASE_API_KEY_NAME=          # organizations/<org-id>/apiKeys/<key-uuid>
COINBASE_API_PRIVATE_KEY=       # -----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----

# ---- Safety: live trading requires BOTH of these plus --mode live ----
KRYPT_MODE=analyze          # analyze | paper | live   (default analyze = read-only)
KRYPT_ALLOW_LIVE=0          # second lock; set to 1 ONLY when you mean real orders
BINANCE_TESTNET=1           # 1 = testnet (fake money). Set 0 for REAL money.

# ---- Universe & cadence ----
KRYPT_SYMBOLS=BTCUSDT       # comma-separated, e.g. BTCUSDT,ETHUSDT
KRYPT_INTERVAL=1m
KRYPT_REFRESH_SECS=5
KRYPT_STRATEGY=scalper      # scalper | market_maker | hedge | trend

# ---- Risk limits (hard, enforced pre-trade) ----
KRYPT_MAX_ORDER_USD=50
KRYPT_MAX_POSITION_USD=200
KRYPT_MAX_OPEN_POSITIONS=3
KRYPT_MAX_DAILY_LOSS_USD=100
KRYPT_MAX_CONSECUTIVE_LOSSES=4
KRYPT_RISK_PER_TRADE_PCT=1.0
KRYPT_STOP_PCT=1.5
KRYPT_TP_PCT=2.0
