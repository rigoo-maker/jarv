# KRYPT configuration — copy to `.env`, fill in, then `source .env` (or use a
# dotenv loader). NEVER commit your real .env (it is gitignored).

# ---- Execution venue: where live orders go ----
KRYPT_VENUE=binance         # binance | coinbase

# ---- Binance API keys (data is free/public; keys only for live Binance) ----
# Create keys at: https://www.binance.com/en/my/settings/api-management
# For first live tests use TESTNET keys from https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Coinbase Advanced Trade keys (only if KRYPT_VENUE=coinbase) ----
# Create at: https://www.coinbase.com/settings/api  (Advanced Trade / CDP key)
# NOTE: Coinbase has no fake-money testnet for this path — use KRYPT_MODE=paper
#       to simulate. Live on Coinbase = REAL money. Needs: pip install PyJWT cryptography
# NEVER paste these into chat or commit them. .env is gitignored.
COINBASE_API_KEY_NAME=          # organizations/<org-id>/apiKeys/<key-uuid>
COINBASE_API_PRIVATE_KEY=       # -----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----

# ---- Safety: live trading requires BOTH of these plus --mode live ----
KRYPT_MODE=analyze          # analyze | paper | live   (default analyze = read-only)
KRYPT_ALLOW_LIVE=0          # second lock; set to 1 ONLY when you mean real orders
BINANCE_TESTNET=1           # 1 = testnet (fake money). Set 0 for REAL money.

# ---- Universe & cadence ----
KRYPT_SYMBOLS=BTCUSDT       # comma-separated, e.g. BTCUSDT,ETHUSDT
KRYPT_INTERVAL=1m
KRYPT_REFRESH_SECS=5
KRYPT_STRATEGY=scalper      # scalper | market_maker | hedge | trend

# ---- Risk limits (hard, enforced pre-trade) ----
KRYPT_MAX_ORDER_USD=50
KRYPT_MAX_POSITION_USD=200
KRYPT_MAX_OPEN_POSITIONS=3
KRYPT_MAX_DAILY_LOSS_USD=100
KRYPT_MAX_CONSECUTIVE_LOSSES=4
KRYPT_RISK_PER_TRADE_PCT=1.0
KRYPT_STOP_PCT=1.5
KRYPT_TP_PCT=2.0

# ─── SOLAI (Solana AI signal trader) ────────────────────────────────────────
# Core is stdlib. The Claude analyst layer needs: pip install anthropic
SOLAI_MODE=scan                 # scan | paper | live (live is NOT implemented)
SOLAI_ALLOW_LIVE=0              # second lock; live still raises NotImplementedError
SOLAI_STATE_DIR=.solai

# Endpoints. The public RPC is heavily rate-limited — use a paid provider for
# anything beyond a handful of tokens, and required for smart-money tracking.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLAI_DEXSCREENER_URL=https://api.dexscreener.com
SOLAI_JUPITER_URL=https://lite-api.jup.ag

# Universe
SOLAI_MINTS=                    # space/comma separated; empty = auto-discover
SOLAI_DISCOVER_LIMIT=30
SOLAI_QUOTE_SIZE_USD=25         # size used to measure REAL round-trip cost

# Smart money — your own researched wallets. SOLAI ships no list on purpose.
SOLAI_SMART_WALLETS=
SOLAI_SMART_LOOKBACK=100

# Account & risk (defaults sized for a $20-$100 account)
SOLAI_EQUITY_USD=100
SOLAI_MAX_POSITION_PCT=25
SOLAI_MAX_OPEN_POSITIONS=3
SOLAI_STOP_PCT=25
SOLAI_TP_PCT=60
SOLAI_TRAIL_PCT=0
SOLAI_MAX_DAILY_LOSS_PCT=20
SOLAI_MAX_CONSECUTIVE_LOSSES=4
SOLAI_FEE_BPS=30                # Jupiter route + AMM fee
SOLAI_SLIPPAGE_BPS=50           # be pessimistic; this is Solana small caps

# Safety screens
SOLAI_MIN_LIQ_USD=25000
SOLAI_MIN_VOL24_USD=50000
SOLAI_MIN_PAIR_AGE_MIN=60
SOLAI_MAX_TOP10_PCT=35
SOLAI_MAX_SINGLE_HOLDER_PCT=12
SOLAI_MAX_PRICE_IMPACT_PCT=3
SOLAI_REQUIRE_MINT_REVOKED=1
SOLAI_REQUIRE_FREEZE_REVOKED=1
SOLAI_REQUIRE_LP_BURNED=0       # cannot be auto-verified yet; see SOLAI.md

# Claude analyst layer (needs ANTHROPIC_API_KEY)
SOLAI_ANALYST=1
SOLAI_ANALYST_MODEL=claude-opus-5
SOLAI_ANALYST_EFFORT=high
SOLAI_ANALYST_TOP_N=5           # bounds LLM spend regardless of scan size
SOLAI_ANALYST_MIN_SCORE=55      # scorer gate before spending a call
